# Secrets. Design rule 9: they live only in .env.
.env
.env.*
# Names only, never a value. Without this line ".env.*" above would hide it.
!.env.example
# Google key files and sign-in files, in case one is saved next to the code by mistake.
# application_default_credentials.json is what "gcloud auth application-default login" writes. It
# holds a refresh token, which is a long-lived login to a Google account. Added on 9 October 2026,
# after such a file was found in the project folder (it had never been committed).
*-key.json
service-account*.json
application_default_credentials.json
client_secret*.json
*credentials*.json
*.pem
*.p12
*.pfx

# Collected pages and everything built from them (design 5.3).
# They can be rebuilt with one command, so they do not belong in git.
# They are also other people's text: a test set in evals/ keeps the address and the
# fingerprint of each page, and the page itself only when its site or licence allows it
# (design 13.1).
data/

# A working plan for one session stays out of git.
/WORKING-PLAN*.md

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Playwright
playwright-report/
test-results/

# Editors and systems
.vscode/
.idea/
.DS_Store
Thumbs.db
