# Names only, never a value. Copy this file to ".env" and fill it in there.
# How to get each value, see README.md
# ".env" is never committed (see .gitignore and design rule 9).
# The names are the same as the fields of src/hackathon_memory/settings.py, in capitals.
# Gate A checked the names that the Google and Hedera libraries read.
# The code passes every value to them on purpose, so none of their own names are needed.

# Hedera: from portal.hedera.com (design section 15, step 1)
# The register is on the test network only in the first version (design section 3.2).
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
# Use the "DER Encoded Private Key" of the portal (a long text that starts with 302).
# A short 64-letter key does not say if it is ED25519 or ECDSA, and the library guesses wrong.
HEDERA_OPERATOR_KEY=
# Filled in after the register topic is created (Phase F)
HEDERA_TOPIC_ID=
# A second topic for rehearsals of a registration, made with
# "python -m hackathon_memory.hedera.registry open --rehearsal". The website writes to it only
# when it is started with --rehearsal (design 9.3).
HEDERA_REHEARSAL_TOPIC_ID=

# GitHub: a personal access token that can only read public repositories (step 2)
GITHUB_TOKEN=

# Google Cloud, for the Gemini models and the embedding model on Vertex AI (step 3)
GOOGLE_CLOUD_PROJECT=
# Use "global": Gemini 3.1 Pro is offered only there (Google's model page, 9 October 2026).
GOOGLE_CLOUD_LOCATION=
# Path to a sign-in file, only if this way of signing in is used. It must be a service account
# key or the file that "gcloud auth application-default login" writes. Keep it OUT of the project
# folder if you can: it is a login. If it is inside, .gitignore keeps it out of git.
GOOGLE_APPLICATION_CREDENTIALS=

# The two Gemini layers (the maintainer's decision of 9 October 2026, design rule 7).
# REWRITE reads a project page and fills its card. SEARCH compares the closest projects with an idea.
# The level of thinking is LOW, MEDIUM or HIGH. Google deprecated the old "thinking budget" for
# Gemini 3 and it is an error when sent with a level, so there is no setting for it.
# Gemini 3.1 Pro is a public preview model: Google may change or retire it.
GEMINI_REWRITE_MODEL=gemini-3.1-pro-preview
GEMINI_REWRITE_THINKING_LEVEL=HIGH
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_SEARCH_THINKING_LEVEL=LOW
# The embedding model of the search: it turns a project and an idea into numbers that can be
# compared. gemini-embedding-2 reads 8,192 tokens of a text and its price is known.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# What the models may cost. "test" is the work before the tool is shown, "prod" is the tool
# while people use it. Each has its own budget in dollars. A call that could go over the budget
# is not made. See what was spent: python -m hackathon_memory.finops report
# LLM_ENVIRONMENT=test
# LLM_BUDGET_TEST_USD=15
# LLM_BUDGET_PROD_USD=30
# LLM_BUDGET_PROD_PER_DAY_USD=5
# LLM_BUDGET_WARN_PERCENT=80

# The local PostgreSQL started by Docker Compose.
# Choose any password. It only protects the copy on your own laptop.
POSTGRES_PASSWORD=
# Optional. Without these lines: user hackathon, database hackathon_memory, port 55432.
# POSTGRES_USER=
# POSTGRES_DB=
# POSTGRES_PORT=
# Optional. When set, it replaces the four POSTGRES lines above (a database that is not local).
DATABASE_URL=

# Optional. Where collected pages are saved. The folder is ignored by git. Default: data
# DATA_DIR=data

# The collector says who it is in every request to a site (design section 5.7).
# This was promised to the sites. The collector refuses to start when one is empty.
COLLECTOR_NAME=HackathonMemory-research
COLLECTOR_CONTACT_EMAIL=

# One switch per site (design section 5.7). "on" lets the collector for that site run.
# Turn it "off" at once when a site asks us to stop.
COLLECT_ETHGLOBAL=off
# GitHub's API: the README of each project's code, read with GITHUB_TOKEN (design 7.3).
COLLECT_GITHUB=off
# The one page with the winners of the Hedera Africa hackathon (design 4.6).
COLLECT_AFRICA_WINNERS=off
# Hedera's own posts with the winners of its older hackathons (design 4.6).
COLLECT_HEDERA_POSTS=off

# GitHub's answers and the facts of the ledger are asked again once they are this old, in hours
# (design 7.3). "on" lets the website do it in the background while it runs; GitHub is asked only
# when COLLECT_GITHUB is on.
REFRESH_AFTER_HOURS=24
REFRESH_IN_BACKGROUND=off
