# Names only, never a value. Copy this file to ".env" and fill it in there.
# ".env" is never committed (see .gitignore and design rule 9).
# The exact names the Google and Hedera libraries expect are verified in Gate A
# (design section 14.2) and corrected here if they differ.

# Hedera: from portal.hedera.com (design section 15, step 1)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Filled in after the register topic is created (Phase F)
HEDERA_TOPIC_ID=

# GitHub: a personal access token that can only read public repositories (step 2)
GITHUB_TOKEN=

# Google Cloud, for Gemini 3.8 Flash and the embedding model on Vertex AI (step 3)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Path to a key file, only if this way of signing in is used
GOOGLE_APPLICATION_CREDENTIALS=

# The local PostgreSQL started by Docker Compose
DATABASE_URL=

# The collector says who it is in every request to a site (design section 5.7).
# This was promised to the sites. The collector refuses to start when one is empty.
COLLECTOR_NAME=HackathonMemory-research
COLLECTOR_CONTACT_EMAIL=
